@startuml
skinparam swimlaneWidth 240
skinparam DefaultFontSize 13
skinparam ArrowColor #333333
skinparam ActivityBorderColor #333333
skinparam ActivityBackgroundColor #f0f8ff
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #ccaa00

title Park-a-Lot Control System — Activity 1 (Single Car)\nThread synchronization via mutex + condition variables

|Car|
start
repeat

  :Arrive at entry gate;
  note right
    cars_at_entry++
    notify_one(entry_cv)
  end note

|Entry Gate|
  :Wait for car at entry;
  note right
    entry_cv.wait(lk)
    predicate: cars_at_entry > 0
  end note

  :Open entry gate;
  note right
    entry_open = true
    notify_all(entry_cv)
  end note

|Car|
  :Wait for gate to open;
  note right
    entry_cv.wait(lk)
    predicate: entry_open == true
  end note

  :Pass through entry gate;
  note right
    entry_open = false
    cars_at_entry--
    notify_all(entry_cv)
  end note

|Entry Gate|
  :Wait for car to pass;
  note right
    entry_cv.wait(lk)
    predicate: entry_open == false
  end note

  :Close entry gate;

|Car|
  :Park\n(sleep for a while);

  :Arrive at exit gate;
  note right
    cars_at_exit++
    notify_one(exit_cv)
  end note

|Exit Gate|
  :Wait for car at exit;
  note right
    exit_cv.wait(lk)
    predicate: cars_at_exit > 0
  end note

  :Open exit gate;
  note right
    exit_open = true
    notify_all(exit_cv)
  end note

|Car|
  :Wait for gate to open;
  note right
    exit_cv.wait(lk)
    predicate: exit_open == true
  end note

  :Pass through exit gate;
  note right
    exit_open = false
    cars_at_exit--
    notify_all(exit_cv)
  end note

|Exit Gate|
  :Wait for car to pass;
  note right
    exit_cv.wait(lk)
    predicate: exit_open == false
  end note

  :Close exit gate;

|Car|
repeat while (running?) is (yes)
->no;
stop

@enduml
