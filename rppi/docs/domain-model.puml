@startuml
skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 55
skinparam class {
  BackgroundColor #FEFECE
  BorderColor #A80036
}
hide methods
hide circle
hide attributes
skinparam style strictuml

title Domain Model — Ready Player Pi (RPPi)

class Player

class "Host Player" as HP
class "Guest Player" as GP
class Server
class "Game Room" as Room
class Game
class Leaderboard
class GyroPi
class NotePi
class Gyroscope
class Maze
class Ball
class "Black Hole" as BH
class Goal
class Microphone
class "Note Sequence" as NoteSeq
class Note

' === Layout hints ===
HP -[hidden]right- GP
GyroPi -[hidden]right- NotePi
Ball -[hidden]right- BH
BH -[hidden]right- Goal

' === All simple lines, no arrows ===
Player -down- HP : is Communicator\nor Performer
Player -down- GP : is Communicator\nor Performer
HP -down- Room : creates
GP -down- Room : joins
Room -left- Server : manages
Room -down- Game : starts
Game -right- Leaderboard : updates
Leaderboard -up- Server : maintains
Game -down- GyroPi
Game -down- NotePi

GyroPi -down- Maze : has
Gyroscope -down- Ball : controls
Maze -down- Ball : contains
Maze -down- BH : has
Maze -down- Goal : has

NotePi -down- NoteSeq : generates
NoteSeq -down- Note : consists of
Microphone -down- Note : records

@enduml
